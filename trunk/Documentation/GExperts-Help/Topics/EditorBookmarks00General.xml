          <para styleclass="Normal" style="margin-bottom:2px; margin-left:6px;"><link displaytype="text" defaultstyle="true" type="topiclink" href="EditorBookmarks30Options" styleclass="Courier Fixed" style="font-size:8pt;" translate="true">Configuration (Options)</link><text styleclass="Courier Fixed" style="font-size:8pt;" translate="true">&#32;</text></para>
